                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_1_type"
                            android:textColor="#2980B9"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                  [cardHero2 = การ์ด Pufferfish] marginTop 6dp ห่างจากใบบน
                -->
                <!-- 🛡️ ตัวที่ 2: Pufferfish -->
                <LinearLayout
                    android:id="@+id/cardHero2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_2" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_2_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_2_type"
                            android:textColor="#D35400"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                  [cardHero3 = การ์ด Shark]
                -->
                <!-- 🔮 ตัวที่ 3: Shark -->
                <LinearLayout
                    android:id="@+id/cardHero3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_3" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_3_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_3_type"
                            android:textColor="#8E44AD"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                  [cardHero4 = การ์ด Octopus]
                -->
                <!-- 🐙 ตัวที่ 4: Octopus -->
                <LinearLayout
                    android:id="@+id/cardHero4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_4" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_4_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_4_type"
                            android:textColor="#C0392B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                  [cardHero5 = การ์ด Electric Eel]
                -->
                <!-- ⚡ ตัวที่ 5: Electric Eel -->
                <LinearLayout
                    android:id="@+id/cardHero5"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_5" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
