                </LinearLayout>
            </LinearLayout>

            <!--
              [layoutHeroDetail = คอลัมน์ขวา แผงรายละเอียดฮีโร่ที่เลือก] กินความกว้างที่เหลือ (0dp + weight 1) ห่างการ์ด 10dp พื้นหลัง #1A252C
                ข้อความในแผงถูกเขียนโดย MainActivity.selectHero ทั้งหมด (ข้อความใน XML เป็นแค่ค่าตั้งต้น)
            -->
            <!-- คอลัมน์ขวา: แผงรายละเอียดฮีโร่ที่เลือก (ห่างจากรายชื่อ 10dp) -->
            <LinearLayout
                android:id="@+id/layoutHeroDetail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="#1A252C"
                android:orientation="vertical"
                android:padding="10dp">

                <!--
                  [แถวบนของแผง] รูปใหญ่ (imgSelectedHero) | ชื่อ-วิชา-คำอธิบาย (txtSelectedName / txtSelectedSubject / txtSelectedDesc) | ปุ่ม FIGHT!
                -->
                <!-- แถวบน: รูป | ชื่อ-วิชา-คำอธิบาย | ปุ่ม FIGHT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgSelectedHero"
                        android:layout_width="100dp"
                        android:layout_height="58dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSelectedName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="กรุณาเลือกตัวละคร"
                            android:textColor="#00ADB5"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSelectedSubject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="วิชา: -"
                            android:textColor="#F39C12"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSelectedDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="แตะเลือกการ์ดฮีโร่ด้านบนเพื่อดูรายละเอียดสกิล"
                            android:textColor="#BDC3C7"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!--
                      [btnFight = ปุ่ม FIGHT!] สีแดง #C0392B ข้อความจาก @string/btn_fight_text กดแล้วเปิด BattleActivity
                        insetTop/Bottom = 0 เพื่อให้ปุ่มสูงเต็ม 52dp (ปุ่ม Material มีขอบว่างเป็นค่าตั้งต้น)
                    -->
                    <!-- ปุ่ม FIGHT! ท้ายแถวบน -->
                    <Button
                        android:id="@+id/btnFight"
                        android:layout_width="120dp"
                        android:layout_height="52dp"
                        android:backgroundTint="#C0392B"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_fight_text"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!--
                  [เส้นคั่น] View สูง 1dp สีขาวโปร่งใสจาง ใช้แบ่งแถวบนกับส่วนสกิล
                -->
                <!-- เส้นคั่น 1dp -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#33FFFFFF" />

                <!--
                  [ส่วนสกิล: ScrollView เลื่อนได้เมื่อยาวเกิน] fillViewport=true ทำให้ 3 บล็อกสกิลกระจายเต็มความสูงเมื่อเนื้อหาไม่เต็ม
                    มี 3 บล็อกเหมือนกัน (Skill 1, Skill 2, Ultimate Skill) แต่ละบล็อก: ป้ายชิป (bg_skill_chip) + ชื่อสกิล (txtSkillNName) + คำอธิบาย (txtSkillNDesc)
                    ข้อความป้ายชิป ("Skill 1" ฯลฯ) เป็นข้อความตายตัวใน XML ส่วนชื่อ/คำอธิบายถูกใส่โดย MainActivity ดึงจากคลาสฮีโร่
                -->
                <!-- ส่วนสกิล: กินความสูงที่เหลือทั้งหมดของแผง
                     fillViewport ทำให้ 3 บล็อกกระจายเท่าๆ กันเมื่อเนื้อหาไม่เต็ม และเลื่อนได้เมื่อเนื้อหายาวเกิน -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/txtSelectedSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!--
                          [บล็อก Skill 1] id: txtSkill1Name (ชื่อ) , txtSkill1Desc (คำอธิบาย) — lineSpacingMultiplier 1.4 = เว้นบรรทัดให้อ่านง่าย
                        -->
                        <!-- Skill 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_skill_chip"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Skill 1"
                                    android:textColor="#00ADB5"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtSkill1Name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtSkill1Desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.4"
                                android:textColor="#ECF0F1"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!--
                          [บล็อก Skill 2] id: txtSkill2Name , txtSkill2Desc
                        -->
                        <!-- Skill 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_skill_chip"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Skill 2"
                                    android:textColor="#00ADB5"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtSkill2Name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtSkill2Desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.4"
                                android:textColor="#ECF0F1"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!--
                          [บล็อก Ultimate] id: txtUltName , txtUltDesc ป้ายชิปสีทอง #F5B041
                        -->
                        <!-- Ultimate Skill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_skill_chip"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Ultimate Skill"
                                    android:textColor="#F5B041"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtUltName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtUltDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.4"
                                android:textColor="#ECF0F1"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
