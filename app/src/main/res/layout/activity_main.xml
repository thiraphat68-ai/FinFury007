<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ============================================== -->
    <!-- หน้าจอที่ 1: เมนูหลัก -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMainMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <VideoView
            android:id="@+id/videoBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold|italic"
            app:layout_constraintBottom_toTopOf="@+id/btnStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00ADB5"
            android:text="@string/btn_start"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@+id/btnSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

        <!-- ปุ่มตั้งค่า (เปิดหน้า SettingsActivity) -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#34495E"
            android:text="⚙ ตั้งค่า"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnStart" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- หน้าจอที่ 2: เลือกด่าน -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLevelSelect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <VideoView
            android:id="@+id/videoBackgroundLevel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtSelectStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/title_select_stage"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- [ด่านที่ 1] -->
        <ImageButton
            android:id="@+id/btnStage1"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnStage2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSelectStage" />

        <!-- [ด่านที่ 2] -->
        <ImageButton
            android:id="@+id/btnStage2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_2"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_blue"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toStartOf="@+id/btnStage3"
            app:layout_constraintStart_toEndOf="@+id/btnStage1"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- [ด่านที่ 3] -->
        <ImageButton
            android:id="@+id/btnStage3"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_3"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_lock"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toStartOf="@+id/btnStage4"
            app:layout_constraintStart_toEndOf="@+id/btnStage2"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- [ด่านที่ 4] -->
        <ImageButton
            android:id="@+id/btnStage4"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_4"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_lock"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toStartOf="@+id/btnStage5"
            app:layout_constraintStart_toEndOf="@+id/btnStage3"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- [ด่านที่ 5] 🐙 BOSS -->
        <ImageButton
            android:id="@+id/btnStage5"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:background="@null"
            android:contentDescription="@string/stage_5"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_boss"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnStage4"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- ดาวที่ทำได้ของแต่ละด่าน (อ่านจาก GamePrefs ตั้งค่าใน MainActivity) -->
        <TextView
            android:id="@+id/txtStars1"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage1"
            app:layout_constraintStart_toStartOf="@id/btnStage1"
            app:layout_constraintTop_toBottomOf="@id/btnStage1" />

        <TextView
            android:id="@+id/txtStars2"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage2"
            app:layout_constraintStart_toStartOf="@id/btnStage2"
            app:layout_constraintTop_toBottomOf="@id/btnStage2" />

        <TextView
            android:id="@+id/txtStars3"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage3"
            app:layout_constraintStart_toStartOf="@id/btnStage3"
            app:layout_constraintTop_toBottomOf="@id/btnStage3" />

        <TextView
            android:id="@+id/txtStars4"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage4"
            app:layout_constraintStart_toStartOf="@id/btnStage4"
            app:layout_constraintTop_toBottomOf="@id/btnStage4" />

        <TextView
            android:id="@+id/txtStars5"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage5"
            app:layout_constraintStart_toStartOf="@id/btnStage5"
            app:layout_constraintTop_toBottomOf="@id/btnStage5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- หน้าจอที่ 3: เลือกตัวละคร -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeroSelect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#040D14"
        android:visibility="gone">

        <!-- 🔙 ปุ่มย้อนกลับ -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_revert"
            android:backgroundTint="#80000000"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtSelectHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/title_select_hero"
            android:textColor="#F39C12"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- รายการการ์ดฮีโร่แบบเลื่อนแนวนอน -->
        <HorizontalScrollView
            android:id="@+id/scrollHeroSelect"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/layoutHeroDetail"
            app:layout_constraintTop_toBottomOf="@id/txtSelectHero">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- ⚔️ ตัวที่ 1: Swordfish -->
                <LinearLayout
                    android:id="@+id/cardHero1"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hero_1_name"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_1_type"
                        android:textColor="#2980B9"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🛡️ ตัวที่ 2: Pufferfish -->
                <LinearLayout
                    android:id="@+id/cardHero2"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_2" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hero_2_name"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_2_type"
                        android:textColor="#D35400"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔮 ตัวที่ 3: Shark -->
                <LinearLayout
                    android:id="@+id/cardHero3"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hero_3_name"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_3_type"
                        android:textColor="#8E44AD"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🐙 ตัวที่ 4: Octopus -->
                <LinearLayout
                    android:id="@+id/cardHero4"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_4" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hero_4_name"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_4_type"
                        android:textColor="#C0392B"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ⚡ ตัวที่ 5: Electric Eel -->
                <LinearLayout
                    android:id="@+id/cardHero5"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_5" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hero_5_name"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_5_type"
                        android:textColor="#27AE60"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 🌟 ส่วนแสดงรายละเอียดฮีโร่ที่ถูกเลือก -->
        <LinearLayout
            android:id="@+id/layoutHeroDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:background="#1A252C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintBottom_toTopOf="@+id/btnFight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollHeroSelect">

            <!-- รูปภาพตัวละครขนาดใหญ่ -->
            <ImageView
                android:id="@+id/imgSelectedHero"
                android:layout_width="140dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:src="@drawable/hero_1" />

            <!-- ข้อมูลชื่อ วิชา และคำอธิบาย -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSelectedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="กรุณาเลือกตัวละคร"
                    android:textColor="#00ADB5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSelectedSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="วิชา: -"
                    android:textColor="#F39C12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSelectedDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="แตะเลือกการ์ดฮีโร่ด้านบนเพื่อดูรายละเอียดสกิล"
                    android:textColor="#BDC3C7"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- คำอธิบายสกิล 1 / สกิล 2 / Ultimate ของฮีโร่ที่เลือก -->
            <TextView
                android:id="@+id/txtSelectedSkills"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1.4"
                android:lineSpacingExtra="2dp"
                android:textColor="#ECF0F1"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ปุ่ม FIGHT! -->
        <Button
            android:id="@+id/btnFight"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#C0392B"
            android:text="@string/btn_fight_text"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>