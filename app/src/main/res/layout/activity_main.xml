<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ============================================== -->
    <!-- หน้าจอที่ 1: เมนูหลัก -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMainMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <VideoView
            android:id="@+id/videoBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold|italic"
            app:layout_constraintBottom_toTopOf="@+id/btnStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00ADB5"
            android:text="@string/btn_start"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@+id/btnSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

        <!-- ปุ่มตั้งค่า (เปิดหน้า SettingsActivity) -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#34495E"
            android:text="⚙ ตั้งค่า"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnStart" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- หน้าจอที่ 2: เลือกด่าน -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLevelSelect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <VideoView
            android:id="@+id/videoBackgroundLevel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 🔙 ปุ่มย้อนกลับ (กลับเมนูหลัก) -->
        <ImageButton
            android:id="@+id/btnBackLevel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:contentDescription="กลับ"
            android:src="@android:drawable/ic_menu_revert"
            android:backgroundTint="#80000000"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtSelectStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/title_select_stage"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- [ด่านที่ 1] -->
        <ImageButton
            android:id="@+id/btnStage1"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnStage2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSelectStage" />

        <!-- [ด่านที่ 2] -->
        <ImageButton
            android:id="@+id/btnStage2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_2"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_blue"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toStartOf="@+id/btnStage3"
            app:layout_constraintStart_toEndOf="@+id/btnStage1"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- [ด่านที่ 3] -->
        <ImageButton
            android:id="@+id/btnStage3"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_3"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_lock"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toStartOf="@+id/btnStage4"
            app:layout_constraintStart_toEndOf="@+id/btnStage2"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- [ด่านที่ 4] -->
        <ImageButton
            android:id="@+id/btnStage4"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:contentDescription="@string/stage_4"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_whirlpool_lock"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toStartOf="@+id/btnStage5"
            app:layout_constraintStart_toEndOf="@+id/btnStage3"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- [ด่านที่ 5] 🐙 BOSS -->
        <ImageButton
            android:id="@+id/btnStage5"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:background="@null"
            android:contentDescription="@string/stage_5"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_boss"
            app:layout_constraintBottom_toBottomOf="@id/btnStage1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnStage4"
            app:layout_constraintTop_toTopOf="@id/btnStage1" />

        <!-- ดาวที่ทำได้ของแต่ละด่าน (อ่านจาก GamePrefs ตั้งค่าใน MainActivity) -->
        <TextView
            android:id="@+id/txtStars1"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage1"
            app:layout_constraintStart_toStartOf="@id/btnStage1"
            app:layout_constraintTop_toBottomOf="@id/btnStage1" />

        <TextView
            android:id="@+id/txtStars2"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage2"
            app:layout_constraintStart_toStartOf="@id/btnStage2"
            app:layout_constraintTop_toBottomOf="@id/btnStage2" />

        <TextView
            android:id="@+id/txtStars3"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage3"
            app:layout_constraintStart_toStartOf="@id/btnStage3"
            app:layout_constraintTop_toBottomOf="@id/btnStage3" />

        <TextView
            android:id="@+id/txtStars4"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage4"
            app:layout_constraintStart_toStartOf="@id/btnStage4"
            app:layout_constraintTop_toBottomOf="@id/btnStage4" />

        <TextView
            android:id="@+id/txtStars5"
            style="@style/StageStars"
            app:layout_constraintEnd_toEndOf="@id/btnStage5"
            app:layout_constraintStart_toStartOf="@id/btnStage5"
            app:layout_constraintTop_toBottomOf="@id/btnStage5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- หน้าจอที่ 3: เลือกตัวละคร (ออกแบบสำหรับจอแนวนอนราว 800 x 360 dp) -->
    <!-- หัวเรื่อง 44dp -> แถวเนื้อหา: [รายชื่อฮีโร่ 196dp | แผงรายละเอียด] ห่างกัน 10dp -->
    <!-- padding ซ้ายขวาขั้นต่ำ 24dp และบวก display cutout ในโค้ด MainActivity -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeroSelect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#040D14"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <!-- 🔙 ปุ่มย้อนกลับ -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_revert"
            android:backgroundTint="#80000000"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtSelectHero"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/title_select_hero"
            android:textColor="#F39C12"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- แถวเนื้อหา: เติมความสูงที่เหลือทั้งหมด -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSelectHero">

            <!-- คอลัมน์ซ้าย: รายชื่อฮีโร่ 5 ใบเรียงลงมา ไม่เลื่อน แบ่งความสูงเท่ากัน -->
            <LinearLayout
                android:id="@+id/scrollHeroSelect"
                android:layout_width="196dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- ⚔️ ตัวที่ 1: Swordfish -->
                <LinearLayout
                    android:id="@+id/cardHero1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_1" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_1_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_1_type"
                            android:textColor="#2980B9"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 🛡️ ตัวที่ 2: Pufferfish -->
                <LinearLayout
                    android:id="@+id/cardHero2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_2" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_2_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_2_type"
                            android:textColor="#D35400"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 🔮 ตัวที่ 3: Shark -->
                <LinearLayout
                    android:id="@+id/cardHero3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_3" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_3_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_3_type"
                            android:textColor="#8E44AD"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 🐙 ตัวที่ 4: Octopus -->
                <LinearLayout
                    android:id="@+id/cardHero4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_4" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_4_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_4_type"
                            android:textColor="#C0392B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ⚡ ตัวที่ 5: Electric Eel -->
                <LinearLayout
                    android:id="@+id/cardHero5"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="#1A252C"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_5" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_5_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/hero_5_type"
                            android:textColor="#27AE60"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- คอลัมน์ขวา: แผงรายละเอียดฮีโร่ที่เลือก (ห่างจากรายชื่อ 10dp) -->
            <LinearLayout
                android:id="@+id/layoutHeroDetail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="#1A252C"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- แถวบน: รูป | ชื่อ-วิชา-คำอธิบาย | ปุ่ม FIGHT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgSelectedHero"
                        android:layout_width="100dp"
                        android:layout_height="58dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSelectedName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="กรุณาเลือกตัวละคร"
                            android:textColor="#00ADB5"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSelectedSubject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="วิชา: -"
                            android:textColor="#F39C12"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSelectedDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="แตะเลือกการ์ดฮีโร่ด้านบนเพื่อดูรายละเอียดสกิล"
                            android:textColor="#BDC3C7"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- ปุ่ม FIGHT! ท้ายแถวบน -->
                    <Button
                        android:id="@+id/btnFight"
                        android:layout_width="120dp"
                        android:layout_height="52dp"
                        android:backgroundTint="#C0392B"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_fight_text"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- เส้นคั่น 1dp -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#33FFFFFF" />

                <!-- ส่วนสกิล: กินความสูงที่เหลือทั้งหมดของแผง
                     fillViewport ทำให้ 3 บล็อกกระจายเท่าๆ กันเมื่อเนื้อหาไม่เต็ม และเลื่อนได้เมื่อเนื้อหายาวเกิน -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/txtSelectedSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Skill 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_skill_chip"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Skill 1"
                                    android:textColor="#00ADB5"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtSkill1Name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtSkill1Desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.4"
                                android:textColor="#ECF0F1"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Skill 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_skill_chip"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Skill 2"
                                    android:textColor="#00ADB5"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtSkill2Name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtSkill2Desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.4"
                                android:textColor="#ECF0F1"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Ultimate Skill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_skill_chip"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Ultimate Skill"
                                    android:textColor="#F5B041"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtUltName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtUltDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.4"
                                android:textColor="#ECF0F1"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
