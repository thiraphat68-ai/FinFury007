<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/battleRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1420">

    <!-- ============================================== -->
    <!-- Layer 1: พื้นที่เกมเพลย์ (ตัวละคร และ ศัตรู) -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/gameArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ตัวละครผู้เล่น -->
        <LinearLayout
            android:id="@+id/playerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="80dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imgPlayer"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="fitCenter"
                android:src="@drawable/hero_1" />
        </LinearLayout>

        <!-- ศัตรูบอททั้ง 5 ตัวจะถูกสร้างแบบ Dynamic ในโค้ด Java -->
    </FrameLayout>

    <!-- ============================================== -->
    <!-- Layer 2: UI ด้านบนซ้าย (รูปโปรไฟล์ + หลอด HP) -->
    <!-- ============================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#34495E"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/hero_1" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtHpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="HP"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/cardProfile"
        app:layout_constraintTop_toTopOf="@id/cardProfile" />

    <ProgressBar
        android:id="@+id/barHp"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="120dp"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progress="80"
        android:progressBackgroundTint="#333333"
        android:progressTint="#2ECC71"
        app:layout_constraintStart_toStartOf="@id/txtHpLabel"
        app:layout_constraintTop_toBottomOf="@id/txtHpLabel" />

    <!-- ============================================== -->
    <!-- Layer 3: UI ด้านบนตรงกลาง (หลอด Stack) -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutStack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Stack"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/barStack"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="90dp"
            android:layout_height="12dp"
            android:max="10"
            android:progress="0"
            android:progressBackgroundTint="#333333"
            android:progressTint="#F39C12" />

        <TextView
            android:id="@+id/txtStackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0/10"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ============================================== -->
    <!-- Layer 4: UI ด้านบนขวา (ปุ่มย้อนกลับ Back) -->
    <!-- ============================================== -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================== -->
    <!-- Layer 5: UI ด้านล่างซ้าย (Joystick) -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/joystickBase"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.4"
        android:background="@drawable/ic_launcher_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/joystickKnob"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:background="#FFFFFF" />
    </FrameLayout>

    <!-- ============================================== -->
    <!-- Layer 6: UI ด้านล่างขวา (ปุ่ม Skill 1 และ Skill 2) -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutSkills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ปุ่ม Skill 1 -->
        <Button
            android:id="@+id/btnSkill1"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="#E74C3C"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Skill 1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="34dp" />

        <!-- ปุ่ม Skill 2 -->
        <Button
            android:id="@+id/btnSkill2"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:backgroundTint="#2980B9"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Skill 2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="34dp" />
    </LinearLayout>

    <!-- ============================================== -->
    <!-- Layer 7: ปุ่ม Ultimate (อยู่เหนือปุ่ม Skill) -->
    <!-- ล็อกไว้จนกว่าสแตกเต็ม + ตอบ quiz ถูก -->
    <!-- ซ่อนอัตโนมัติสำหรับฮีโร่ที่ยังใช้ Ultimate อัตโนมัติ -->
    <!-- ============================================== -->
    <Button
        android:id="@+id/btnUltimate"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.4"
        android:backgroundTint="#F39C12"
        android:enabled="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="🔒 ULT"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="38dp"
        app:layout_constraintBottom_toTopOf="@id/layoutSkills"
        app:layout_constraintEnd_toEndOf="@id/layoutSkills"
        app:layout_constraintStart_toStartOf="@id/layoutSkills" />

</androidx.constraintlayout.widget.ConstraintLayout>