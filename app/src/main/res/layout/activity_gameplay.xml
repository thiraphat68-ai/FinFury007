<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1420">

    <!-- ============================================== -->
    <!-- Layer 1: พื้นหลัง หรือ View ของเกม (ใส่ภาพหรือ SurfaceView ของคุณตรงนี้) -->
    <!-- ============================================== -->
    <!-- <ImageView android:layout_width="match_parent" android:layout_height="match_parent" ... /> -->

    <!-- ============================================== -->
    <!-- Layer 2: UI ด้านบนซ้าย (รูปโปรไฟล์ + หลอด HP) -->
    <!-- ============================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#34495E"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- รูปหน้าตัวละคร (เปลี่ยน @drawable/hero_1 เป็นรูปของคุณ) -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/hero_1" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtHpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="HP"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/cardProfile"
        app:layout_constraintTop_toTopOf="@id/cardProfile" />

    <ProgressBar
        android:id="@+id/barHp"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="140dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="80"
        android:progressBackgroundTint="#333333"
        android:progressTint="#2ECC71"
        app:layout_constraintStart_toStartOf="@id/txtHpLabel"
        app:layout_constraintTop_toBottomOf="@id/txtHpLabel" />

    <!-- ============================================== -->
    <!-- Layer 3: UI ด้านบนตรงกลาง (หลอด Stack) -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutStack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Stack"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/barStack"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="100dp"
            android:layout_height="14dp"
            android:max="10"
            android:progress="5"
            android:progressBackgroundTint="#333333"
            android:progressTint="#F39C12" />

        <TextView
            android:id="@+id/txtStackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="5/10"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ============================================== -->
    <!-- Layer 4: UI ด้านบนขวา (ปุ่ม Pause) -->
    <!-- ============================================== -->
    <ImageButton
        android:id="@+id/btnPause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_media_pause"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================== -->
    <!-- Layer 5: UI ด้านล่างซ้าย (กรอบ Joystick) -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/layoutJoystick"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp"
        android:background="#33FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- นำ View Joystick ของคุณมาใส่ข้างใน FrameLayout นี้ได้เลย -->
        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="#80FFFFFF" />
    </FrameLayout>

    <!-- ============================================== -->
    <!-- Layer 6: UI ด้านล่างขวา (ปุ่ม Attack & Skill) -->
    <!-- ============================================== -->
    <!-- ปุ่มตีธรรมดา (Attack) - วงใหญ่ -->
    <Button
        android:id="@+id/btnAttack"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#E74C3C"
        android:text="Attack"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSkill" />

    <!-- ปุ่มสกิล (Skill) - วงเล็กกว่านิดหน่อย -->
    <Button
        android:id="@+id/btnSkill"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="#2C3E50"
        android:text="Skill"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>